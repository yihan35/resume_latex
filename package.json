{
  "name": "resume-latex-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "editor": "concurrently -k \"npm:server\" \"npm:client\"",
    "start:editor": "./scripts/start.sh",
    "stop:editor": "./scripts/stop.sh",
    "server": "PATH=/Library/TeX/texbin:$PATH tsx watch server/src/index.ts",
    "client": "vite --host 127.0.0.1",
    "build": "tsc -p server/tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.61.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "jsdom": "^25.0.1",
    "rollup": "npm:@rollup/wasm-node@^4.61.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "vite": "^6.0.7"
  }
}
